SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key used for evaluation/report persistence. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=
# If your project still uses the legacy name, SUPABASE_ANON_KEY is also accepted.
FRONTEND_ORIGIN=http://localhost:5173

# P4 AI Provider Configuration - Required for LIVE interview mode
# Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional: Override the default model (gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# ElevenLabs API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Optional: Override the default voice ID (Rachel - 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: Override the default model
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
